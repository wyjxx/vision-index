# Local Python app: URL used to connect to Ollama on this machine.
# This does not configure the Ollama server's listening address.
OLLAMA_HOST=http://127.0.0.1:11434

# Docker app: URL used to connect from the container to the host Ollama.
# Do not use localhost here: inside a container it means the container itself.
# Compose passes this value to the app as OLLAMA_HOST.
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# Shared by local Python and Docker. Pull these models on the host first.
# If changing the embedding model, rebuild the vector index before searching.
VISION_MODEL=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text:latest

# Docker only: host port for the web UI (http://localhost:8000 by default).
APP_PORT=8000
