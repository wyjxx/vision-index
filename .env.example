# Copy this file to .env for local use.
# Put real API keys in .env only

# V2 CLIP application. Use a separate collection when changing model weights.
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_COLLECTION=vision_index_clip_products

# Deepseek API key
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# Docker only: host port for the web UI (http://localhost:8000 by default).
APP_PORT=8000

# Legacy V1 only; not used by the Docker application.
OLLAMA_HOST=http://127.0.0.1:11434
VISION_MODEL=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text:latest
